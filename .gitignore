# ============================================================
# ComfyMax - Git ignore rules
# ============================================================

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Local developer tools
Git_Dev_Manager.bat

# Virtual environments
.venv/
venv/
env/

# Streamlit
.streamlit/

# Local ComfyMax configuration
config/app.json
config/settings.json

# Generated / temporary media
output/
outputs/
temp/
tmp/
*.mp4
*.webm
*.mov

# Logs
*.log

# Windows
Thumbs.db
Desktop.ini

# IDE / editor
.vscode/
.idea/

# Environment and secrets
.env
.env.*
*.key

# Temporary / backup files
*.bak
*.tmp
*~
# Isolated FlashVSR runtime
engines/flashvsr/env_venv/
engines/flashvsr/models/
engines/flashvsr/.setup.lock
config/flashvsr.json

# Private local approved prompts
/data/
